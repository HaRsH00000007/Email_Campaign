# ============================================================================
#  email-campaigning — root .gitignore
#
#  Rule of thumb: source code and .env.example files are committed. Secrets,
#  installed dependencies, build output and machine-local files are not.
# ============================================================================

# ---------------------------------------------------------------------------
# Secrets and credentials — NEVER commit. Only .env.example belongs in git.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.p8
*.crt
*.cer
*.der
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*

# Google / GCP service-account and OAuth client credential files.
# Google Cloud Console downloads OAuth clients as client_secret_*.json.
service-account*.json
service_account*.json
client_secret*.json
credentials.json
gcp-deploy-key.json
*-deploy-key.json
gcp-*.json
.gcloud/

# Generic secret dumps
secrets/
secrets.*
*.secret
*.secrets
!*.secrets.example

# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/install-state.gz

# ---------------------------------------------------------------------------
# Build and cache output — frontend (Next.js) and backend
# ---------------------------------------------------------------------------
.next/
out/
dist/
build/
.turbo/
.vercel/
.swc/
*.tsbuildinfo
next-env.d.ts
.cache/
.parcel-cache/
.eslintcache

# ---------------------------------------------------------------------------
# Tests and coverage
# ---------------------------------------------------------------------------
coverage/
.nyc_output/
test-results/
junit.xml
*.lcov

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------------------------------------------------------------------------
# Local Docker overrides (these routinely hold local secrets and ports)
# ---------------------------------------------------------------------------
docker-compose.override.yml
docker-compose.override.yaml
docker-compose.*.local.yml
.docker/

# ---------------------------------------------------------------------------
# Temporary and local-only files
# ---------------------------------------------------------------------------
tmp/
temp/
.tmp/
*.tmp
*.temp
*.bak
*.orig
*.rej
*.pid
*.seed
*.pid.lock
.local/
scratch/

# Local database / queue dumps, if ever produced on the host
*.rdb
dump.rdb
*.sqlite
*.sqlite3
mongo-data/
redis-data/

# ---------------------------------------------------------------------------
# Editors and IDEs
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.iml
*.swp
*.swo
*~
.project
.settings/
*.sublime-workspace
*.sublime-project

# ---------------------------------------------------------------------------
# Operating system
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
