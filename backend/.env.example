# ─── Core ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Public URL of THIS backend. Used to build the public <img> URLs embedded in
# campaign templates, so email clients can fetch them. Must be reachable from
# the public internet for images to render in delivered mail.
PUBLIC_URL=http://localhost:4000

# Origin of the frontend, for CORS and post-OAuth redirects.
FRONTEND_URL=http://localhost:3000

# ─── Database ────────────────────────────────────────────────────────────────
# MUST be its own database. Never point this at another project's DB.
MONGODB_URI=mongodb://127.0.0.1:27018/email_campaigning

# Nameservers for resolving a mongodb+srv:// seed list, comma separated.
# Leave unset unless the backend fails to start with:
#   querySrv ECONNREFUSED _mongodb._tcp.<cluster>.mongodb.net
# That means the host handed Node's in-process resolver no usable nameserver
# (nslookup can still work -- it uses a different resolver). Setting this, or
# fixing the host's DNS, resolves it. Affects SRV lookups only.
# DNS_SERVERS=1.1.1.1,8.8.8.8

# ─── Redis (REQUIRED for delivery) ───────────────────────────────────────────
# Without Redis there is no queue, no leader lock and no mailbox rate limiting.
# The sender deliberately refuses to send rather than lose leads. Use rediss://
# for TLS providers such as Redis Cloud.
REDIS_URL=redis://127.0.0.1:6380

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=30d

# AES-256-GCM key for encrypting Google OAuth tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CHANGING THIS MAKES EVERY STORED TOKEN UNDECRYPTABLE — mailboxes must reconnect.
TOKEN_ENC_KEY=replace-me-with-a-32-byte-hex-key

# ─── Google OAuth (REQUIRED) ─────────────────────────────────────────────────
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# (Web application). Add GOOGLE_REDIRECT_URI to "Authorised redirect URIs".
# Enable the Gmail API on the project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/mailboxes/oauth/callback

# ─── AI personalization (OPTIONAL) ───────────────────────────────────────────
# Powers per-recipient rewriting ("unique emails") and AI template drafting.
# With neither key set, both features degrade cleanly: rewriting sends the
# original copy, and template generation returns a clear "not configured" error.
GEMINI_API_KEY=
OPENAI_API_KEY=

AI_REWRITE_MODEL=gemini-2.5-flash
AI_TEMPLATE_MODEL=gpt-4o-mini

# ─── Mailbox send pacing ─────────────────────────────────────────────────────
# Sending is paced by a MINIMUM GAP PER MAILBOX, not by an application daily
# quota. This is the primary throttle and the only one that is on by default.
#
# 60000 = one email per mailbox per minute (~60/hour, ~1440/day ceiling).
# Enforced atomically in Redis, so concurrent workers, retries, scheduled
# batches and multiple campaigns sharing a mailbox cannot collectively beat it.
# Other mailboxes are unaffected — each has its own clock.
# Set to 0 to disable spacing entirely (not recommended: it IS the pacing).
MAILBOX_MIN_SPACING_MS=60000

# OPTIONAL hard hourly ceiling. Unset / 0 / "off" = none, which is the default.
#
# How it interacts with the spacing above: 60s spacing already caps a mailbox at
# 60/hour, so any value >= 60 here is inert (the app logs this at startup).
# A value BELOW 60 becomes the binding constraint and will idle the mailbox for
# the remainder of each clock hour once hit — that stop-and-wait behaviour is
# exactly what the spacing rule replaces, so only set it if you want it.
# MAILBOX_HOURLY_LIMIT=
#
# THERE IS NO MAILBOX_DAILY_LIMIT ANY MORE. It was removed deliberately rather
# than raised to a large number: a campaign must not stop because of a quota we
# invented. Daily sends are still COUNTED for the dashboard, never enforced.
#
# Google's real limits are unchanged and still apply — roughly 500 recipients/day
# for a consumer account and 2000 for Workspace, plus shorter-window throttles,
# all enforced server-side by Google. When Google refuses, the sender detects the
# rate-limit response, reads its Retry-After, and parks the WHOLE mailbox on a
# shared cooldown until it expires. This app has no unlimited sending mode.
#
# DELIVERABILITY IS A SEPARATE QUESTION from quota. For cold outreach, inbox
# placement collapses long before Google's ceiling. Scale by adding mailboxes,
# not by shrinking the gap.

# ─── Queue / worker tuning ───────────────────────────────────────────────────
EMAIL_QUEUE_NAME=campaign-emails
EMAIL_MAX_ATTEMPTS=5
EMAIL_WORKER_CONCURRENCY=20

# ─── Reaper (recovers claims that were never delivered) ──────────────────────
EMAIL_STUCK_AFTER_MS=900000
EMAIL_GIVE_UP_AFTER_MS=172800000
EMAIL_REAPER_INTERVAL_MS=300000

# ─── Reply polling safety net ────────────────────────────────────────────────
EMAIL_REPLY_POLL_BUDGET=5

# ─── Process roles ───────────────────────────────────────────────────────────
# Comma-separated: api, scheduler, worker. Default "api,scheduler,worker" runs
# everything in one process (fine for dev and small deployments). Split them to
# scale sending independently of the API.
ROLES=api,scheduler,worker
